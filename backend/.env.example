# Environment Variables Template
NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://smartbiz_user:smartbiz_secure_password_2026@postgres:5432/smartbiz_enterprise_db?schema=public

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=smartbiz_redis_secret

# Security & Secrets
JWT_SECRET=super_secret_enterprise_jwt_signing_key_smartbiz_2026
JWT_EXPIRATION=15m
REFRESH_TOKEN_SECRET=super_secret_enterprise_refresh_token_signing_key_smartbiz_2026
REFRESH_TOKEN_EXPIRATION=7d

# CORS & Host Limits
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://app.smartbiz.com
THROTTLE_TTL=60
THROTTLE_LIMIT=120
